# --- Data ---
# Neon: `neon env pull --file .env -s postgres` fills both. Local docker: use the same URL twice.
DATABASE_URL=postgresql://ftc:ftc@localhost:5432/fridgetocart
DATABASE_URL_UNPOOLED=postgresql://ftc:ftc@localhost:5432/fridgetocart
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- LLM providers. The defaults below only need GOOGLE_API_KEY ---
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Model routing: "<provider>:<model>", provider = google | openai | anthropic ---
VISION_MODEL_FAST=google:gemini-3.5-flash-lite
VISION_MODEL_STRONG=google:gemini-3.5-flash
TEXT_MODEL=google:gemini-3.5-flash-lite
EMBED_MODEL=google:gemini-embedding-2
# Dimension of every vector(N) column (max 2000). After changing it, run `pnpm db:push`
# and re-embed; the API refuses to start while the DB and this value disagree.
EMBED_DIM=1536
# ₹ per US$ for the cost logs
USD_INR=88

# --- Image storage. Leave S3_BUCKET empty to store uploads on local disk (dev only) ---
S3_BUCKET=
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Services ---
API_PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
STORE_PORT=4100
STORE_BASE_URL=http://localhost:4100

# --- Auth ---
# NextAuth session secret and the secret apps/web uses to sign API tokens (apps/api verifies them).
# Generate each with: openssl rand -base64 48
NEXTAUTH_SECRET=
API_JWT_SECRET=
AUTH_TRUST_HOST=true
# Email + password login for exactly two accounts (the emails are fixed in apps/web/lib/demoAuth.ts):
#   tester@fridgetocart.demo (role user)  uses DEMO_USER_PASSWORD. This password is SHOWN on the sign-in page
#                                          for portfolio visitors, so use a throwaway value.
#   aditi@fridgetocart.demo  (role admin) uses ADMIN_PASSWORD. Never displayed; keep it private.
# Min 8 characters; an account with a missing or shorter password cannot sign in. Never commit real values.
DEMO_USER_PASSWORD=
ADMIN_PASSWORD=
# Email-only sign-in without a password, for local dev only. Always off when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# --- Tracing (optional) ---
# The built-in trace (GET /scans/:id/trace) always works. For full LangGraph traces in LangSmith,
# set a key from https://smith.langchain.com and LANGSMITH_TRACING=true; LangChain picks it up.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=fridgetocart
