generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Neon: pooled URL for the app, direct URL for schema pushes/migrations
  directUrl  = env("DATABASE_URL_UNPOOLED")
  extensions = [vector]
}

enum ScanStatus {
  detecting
  awaiting_review
  generating
  awaiting_pick
  building_cart
  done
  failed
}

enum Diet {
  veg
  nonveg
  jain
  egg
}

model User {
  id          String   @id
  email       String   @unique
  diet        Diet     @default(veg)
  avoid       String[] @default([])
  maxTimeMins Int      @default(30)
  scans       Scan[]
}

model Scan {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  imageUrl         String
  status           ScanStatus @default(detecting)
  selectedRecipeId String?
  createdAt        DateTime   @default(now())
  cart             Cart?

  @@index([userId, createdAt])
}

model IngredientCanon {
  canonicalId  String                       @id
  name         String
  synonyms     String[]
  /// nonveg | egg | nojain | staple (staples are assumed in stock, never "missing")
  tags         String[]                     @default([])
  embedding    Unsupported("vector(1536)")?
  /// The text `embedding` was computed from; re-seeding re-embeds only when it changes.
  embeddedText String?
  products     Product[]
}

model RecipeDoc {
  id            String                       @id
  title         String
  /// Ingredient[] (canonicalId, name, qty, unit)
  ingredients   Json
  ingredientIds String[]
  steps         Json
  timeMins      Int
  /// Diets that can eat this dish, e.g. ["jain","veg","egg","nonveg"]
  dietTags      String[]
  course        String
  sourceUrl     String
  embedding     Unsupported("vector(1536)")?
  embeddedText  String?

  @@index([dietTags], type: Gin)
}

model Product {
  id          String          @id
  canonicalId String
  ingredient  IngredientCanon @relation(fields: [canonicalId], references: [canonicalId])
  name        String
  unit        String
  price       Float
  stock       Int
  cartItems   CartItem[]
}

model Cart {
  id     String     @id @default(cuid())
  scanId String     @unique
  scan   Scan       @relation(fields: [scanId], references: [id])
  total  Float      @default(0)
  items  CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int
  price     Float

  @@unique([cartId, productId])
}

/// Replays the stored response for a repeated POST /carts/:id/items with the same Idempotency-Key.
model IdempotencyKey {
  key       String   @id
  response  Json
  createdAt DateTime @default(now())
}

/// One row per LLM/embedding call made while handling a scan (the built-in trace; also feeds eval cost).
model LlmCall {
  id           String   @id @default(cuid())
  scanId       String
  node         String
  model        String
  inputTokens  Int
  outputTokens Int
  costInr      Float
  latencyMs    Int
  ok           Boolean
  createdAt    DateTime @default(now())

  @@index([scanId, createdAt])
}
